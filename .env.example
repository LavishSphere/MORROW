# Copy to .env locally. Never commit real values.
# Server-only secrets — do NOT put these in VITE_* vars.

# Optional Gemini drafting (template path works when unset).
GEMINI_API_KEY=
# gemini-3.8-flash is always tried first; set this only to add a second choice.
GEMINI_MODEL=gemini-3.8-flash

# Optional Tiger Data / PostGIS (TLS). Shape only — paste a real URL locally.
# postgresql://USER:PASSWORD@HOST:5432/tsdb?sslmode=require
DATABASE_URL=

# Optional live transit keys (free developer keys). Feeds without a key stay off.
WMATA_API_KEY=
CTA_TRAIN_TRACKER_KEY=
METRA_API_TOKEN=
TRIMET_APP_ID=
SF511_API_KEY=

# API listen (Docker / Vultr usually HOST=0.0.0.0).
PORT=8787
HOST=127.0.0.1
MORROW_CORS_ORIGIN=

# Front-end (Vite / GitHub Pages build). Public HTTPS origin of the API, no trailing slash.
# Example after Vultr deploy: https://api.example.com
VITE_API_BASE=
